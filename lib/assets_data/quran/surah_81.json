{"source": {"sourceName": "Tanzil Project — النص العثماني برواية حفص عن عاصم (عبر AlQuran Cloud)", "authorOrScholar": null, "reference": "quran-uthmani", "sourceUrl": "https://tanzil.net", "lastUpdated": "2026-06-12T00:00:00.000"}, "number": 81, "ayahs": [{"ayahNumber": 1, "textArabic": "إِذَا ٱلشَّمْسُ كُوِّرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 2, "textArabic": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 3, "textArabic": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 4, "textArabic": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ", "juz": 30, "page": 586}, {"ayahNumber": 5, "textArabic": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 6, "textArabic": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 7, "textArabic": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ", "juz": 30, "page": 586}, {"ayahNumber": 8, "textArabic": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ", "juz": 30, "page": 586}, {"ayahNumber": 9, "textArabic": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ", "juz": 30, "page": 586}, {"ayahNumber": 10, "textArabic": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 11, "textArabic": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ", "juz": 30, "page": 586}, {"ayahNumber": 12, "textArabic": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 13, "textArabic": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ", "juz": 30, "page": 586}, {"ayahNumber": 14, "textArabic": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ", "juz": 30, "page": 586}, {"ayahNumber": 15, "textArabic": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ", "juz": 30, "page": 586}, {"ayahNumber": 16, "textArabic": "ٱلْجَوَارِ ٱلْكُنَّسِ", "juz": 30, "page": 586}, {"ayahNumber": 17, "textArabic": "وَٱلَّيْلِ إِذَا عَسْعَسَ", "juz": 30, "page": 586}, {"ayahNumber": 18, "textArabic": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ", "juz": 30, "page": 586}, {"ayahNumber": 19, "textArabic": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 20, "textArabic": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 21, "textArabic": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 22, "textArabic": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 23, "textArabic": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ", "juz": 30, "page": 586}, {"ayahNumber": 24, "textArabic": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 25, "textArabic": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ", "juz": 30, "page": 586}, {"ayahNumber": 26, "textArabic": "فَأَيْنَ تَذْهَبُونَ", "juz": 30, "page": 586}, {"ayahNumber": 27, "textArabic": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ", "juz": 30, "page": 586}, {"ayahNumber": 28, "textArabic": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ", "juz": 30, "page": 586}, {"ayahNumber": 29, "textArabic": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ", "juz": 30, "page": 586}]}